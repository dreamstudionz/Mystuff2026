local dragging = false
local dragStart = nil
local startPos = nil

local function dragStartFn(input)
    dragging = true
    dragStart = input.Position
    startPos = frame.Position
end
local function dragMoveFn(input)
    if not dragging then return end
    local delta = input.Position - dragStart
    frame.Position = UDim2.new(
        startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y
    )
end
local function dragEndFn() dragging = false end

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        local mouse = UserInputService:GetMouseLocation()
        local mpos = minimizeBtn.AbsolutePosition
        local msize = minimizeBtn.AbsoluteSize
        local cpos = closeBtn.AbsolutePosition
        local csize = closeBtn.AbsoluteSize
        local overMin = mouse.X >= mpos.X and mouse.X <= mpos.X + msize.X
                    and mouse.Y >= mpos.Y and mouse.Y <= mpos.Y + msize.Y
        local overClose = mouse.X >= cpos.X and mouse.X <= cpos.X + csize.X
                       and mouse.Y >= cpos.Y and mouse.Y <= cpos.Y + csize.Y
        if overMin or overClose then return end
        dragStartFn(input)
    end
end)

