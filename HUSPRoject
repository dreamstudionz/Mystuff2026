    if dropdown.Visible and input.UserInputType == Enum.UserInputType.MouseButton1 then
        local mouse = UserInputService:GetMouseLocation()
        local guiPos = frame.AbsolutePosition
        local guiSize = frame.AbsoluteSize
        local inside = mouse.X >= guiPos.X and mouse.X <= guiPos.X + guiSize.X
                   and mouse.Y >= guiPos.Y and mouse.Y <= guiPos.Y + guiSize.Y
        if not inside then closeDropdown() end
    end
end)

