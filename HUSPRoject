-- ── Drag logic for floating button (drag anywhere on it, but clicks on the grab side still fire) ──
local fDragging = false
local fDragMoved = false
local fDragStart = nil
local fStartPos = nil
local F_DRAG_THRESHOLD = 6  -- pixels moved before it counts as a drag

local function beginFDrag(input)
    fDragging = true
    fDragMoved = false
    fDragStart = input.Position
    fStartPos = floatFrame.Position
end

local function moveFDrag(input)
    if not fDragging then return end
    local delta = input.Position - fDragStart
    if math.abs(delta.X) > F_DRAG_THRESHOLD or math.abs(delta.Y) > F_DRAG_THRESHOLD then
        fDragMoved = true
    end
    floatFrame.Position = UDim2.new(
        fStartPos.X.Scale, fStartPos.X.Offset + delta.X,
        fStartPos.Y.Scale, fStartPos.Y.Offset + delta.Y
    )
end

local function endFDrag()
    fDragging = false
    -- small delay so MouseButton1Click can read fDragMoved
    task.delay(0.05, function() fDragMoved = false end)
end

-- Attach drag handlers to BOTH the drag handle and the frame itself
for _, obj in ipairs({dragHandle, floatFrame}) do
    obj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            beginFDrag(input)
        end
    end)
    obj.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            moveFDrag(input)
        end
    end)
    obj.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            endFDrag()
        end
    end)
end

