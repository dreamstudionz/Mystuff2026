local function closeDropdown()
    dropdown.Visible = false
    dropdown.Size = UDim2.new(1, -20, 0, 0)
    dropdownBtn.Text = "▼"
end

local function populateDropdown()
    for _, child in ipairs(dropdown:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local others = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(others, p)
        end
    end
    table.sort(others, function(a, b) return a.Name:lower() < b.Name:lower() end)

    local ROW_H = 28
    local MAX_ROWS = 6
    local rows = math.min(#others, MAX_ROWS)

    if #others == 0 then
        local empty = Instance.new("TextButton")
        empty.Size = UDim2.new(1, -8, 0, ROW_H)
        empty.BackgroundColor3 = Color3.fromRGB(45, 35, 65)
        empty.Text = "No other players in server"
        empty.TextColor3 = Color3.fromRGB(140, 130, 160)
        empty.Font = Enum.Font.Gotham
        empty.TextSize = 12
        empty.BorderSizePixel = 0
        empty.ZIndex = 21
        empty.Parent = dropdown
        Instance.new("UICorner", empty).CornerRadius = UDim.new(0, 4)
        dropdown.CanvasSize = UDim2.new(0, 0, 0, ROW_H + 8)
        dropdown.Size = UDim2.new(1, -20, 0, ROW_H + 16)
        return
    end

    for i, p in ipairs(others) do
        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, -8, 0, ROW_H)
        row.BackgroundColor3 = Color3.fromRGB(50, 40, 72)
        row.Text = "  " .. p.Name .. "  ·  " .. p.DisplayName
        row.TextColor3 = Color3.fromRGB(230, 225, 245)
        row.Font = Enum.Font.Gotham
        row.TextSize = 12
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.BorderSizePixel = 0
        row.ZIndex = 21
        row.LayoutOrder = i
        row.Parent = dropdown
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)

        row.MouseEnter:Connect(function() row.BackgroundColor3 = Color3.fromRGB(80, 60, 110) end)
        row.MouseLeave:Connect(function() row.BackgroundColor3 = Color3.fromRGB(50, 40, 72) end)

        row.MouseButton1Click:Connect(function()
            inputBox.Text = p.Name
            closeDropdown()
            if resultLabel then
                resultLabel.Text = "👤 Selected: " .. p.Name
                resultLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            end
        end)
    end

    dropdown.CanvasSize = UDim2.new(0, 0, 0, rows * (ROW_H + 2) + 8)
    dropdown.Size = UDim2.new(1, -20, 0, rows * (ROW_H + 2) + 16)
end

local function toggleDropdown()
    if dropdown.Visible then closeDropdown(); return end
    populateDropdown()
    dropdown.Visible = true
    dropdownBtn.Text = "▲"
end

inputBox.Focused:Connect(toggleDropdown)
dropdownBtn.MouseButton1Click:Connect(toggleDropdown)

