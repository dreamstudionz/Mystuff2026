-- ============================================
-- 🔍 AUTO-DETECT GRAB REMOTE
-- ============================================
local GrabRF = nil

local function findGrabRemote()
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) then
            if d.Name:lower() == "grab" then return d end
        end
    end
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) then
            local n = d.Name:lower()
            if n:find("grab") and not n:find("ungrab") and not n:find("release") and not n:find("drop") then
                return d
            end
        end
    end
    return nil
end

GrabRF = findGrabRemote()
print("[HUS] GrabRF =", GrabRF and (GrabRF:GetFullName() .. " [" .. GrabRF.ClassName .. "]") or "NOT FOUND")

-- ============================================
-- 🔎 FIND PLAYER
-- ============================================
local function findPlayerByName(name)
    if not name or name == "" then return nil end
    name = name:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and (p.Name:lower() == name or p.DisplayName:lower() == name) then
            return p
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and (p.Name:lower():find(name, 1, true) or p.DisplayName:lower():find(name, 1, true)) then
            return p
        end
    end
    return nil
end

-- ============================================
-- 🔥 FIRE GRAB
-- ============================================
local function fireGrab(target)
    if not GrabRF or not target then return end
    pcall(function()
        if GrabRF:IsA("RemoteFunction") then
            GrabRF:InvokeServer(target)
        else
            GrabRF:FireServer(target)
        end
    end)
end

-- ============================================
-- 🚀 TELEPORT + GRAB
-- ============================================
local function teleportAndGrab(targetPlayer)
    if not targetPlayer then warn("[HUS] Target is nil") return false end
    if not GrabRF then warn("[HUS] Grab remote not found") return false end

    local targetChar = targetPlayer.Character
    if not targetChar then warn("[HUS] Target has no character") return false end

    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    local targetHu = targetChar:FindFirstChildOfClass("Humanoid")
    if not targetHRP or not targetHu or targetHu.Health <= 0 then
        warn("[HUS] Target dead / no HRP") return false
    end

    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHu = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not myHRP then warn("[HUS] You have no character") return false end

    local frontPos = targetHRP.CFrame * CFrame.new(0, 0, CONFIG.GrabDistance)
    myHRP.CFrame = CFrame.new(frontPos.Position, targetHRP.Position)
    if myHu then myHu.AutoRotate = false end

    for i = 1, CONFIG.GrabSpamCount do
        fireGrab(targetPlayer)
        task.wait(CONFIG.GrabSpamDelay)
    end

    local startTime = tick()
    while tick() - startTime < CONFIG.FaceLockTime do
        if targetHRP.Parent and myHRP.Parent then
            myHRP.CFrame = CFrame.new(myHRP.Position, targetHRP.Position)
        end
        RunService.RenderStepped:Wait()
    end

    if myHu then myHu.AutoRotate = true end
    print("[HUS] Grabbed", targetPlayer.Name)
    return true
end

-- ============================================
-- 🔁 SPAM STATE
-- ============================================
local spamActive = false
local spamConn = nil
local spamTargetName = ""

local function stopSpam()
    spamActive = false
    if spamConn then spamConn:Disconnect(); spamConn = nil end
    print("[HUS] Spam grab STOPPED")
end

local function startSpam(name)
    stopSpam()
    if name == "" then return false end
    spamTargetName = name
    spamActive = true
    print("[HUS] Spam grab STARTED on:", name)

    spamConn = RunService.Heartbeat:Connect(function()
        if not spamActive then return end
        local target = findPlayerByName(spamTargetName)
        if not target or not target.Character then return end
        local hu = target.Character:FindFirstChildOfClass("Humanoid")
        if not hu or hu.Health <= 0 then return end
        fireGrab(target)
    end)
    return true
end

-- ============================================
-- ⌨️ KEYBINDS
-- ============================================
local keybinds = { spam = nil, tp = nil }
local capturingFor = nil
local CAPTURE_ACTION = "HUS_GrabSystem_Capture"
local ACTIONS = {
    spam = "HUS_GrabSystem_SpamAction",
    tp   = "HUS_GrabSystem_TPAction",
}

local spamKeyBtn, tpKeyBtn, spamBtn, resultLabel, inputBox

local function refreshKeyBtn(which)
    local btn = (which == "spam") and spamKeyBtn or tpKeyBtn
    local bind = keybinds[which]
    if not btn then return end
    if bind then
        btn.Text = bind.Name
        btn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
    else
        btn.Text = "KEY"
        btn.BackgroundColor3 = Color3.fromRGB(80, 60, 110)
    end
end

local function unbindAction(which)
    if ACTIONS[which] then
        pcall(function() ContextActionService:UnbindAction(ACTIONS[which]) end)
    end
end

local function bindAction(which, key)
    unbindAction(which)
    keybinds[which] = key

    ContextActionService:BindActionAtPriority(
        ACTIONS[which],
        function(_, state)
            if state ~= Enum.UserInputState.Begin then
                return Enum.ContextActionResult.Pass
            end

            if which == "spam" then
                if spamActive then
                    stopSpam()
                    if spamBtn then
                        spamBtn.Text = "OFF"
                        spamBtn.BackgroundColor3 = Color3.fromRGB(80, 60, 110)
                    end
                    if resultLabel then
                        resultLabel.Text = "🔁 Spam grab stopped (keybind)"
                        resultLabel.TextColor3 = Color3.fromRGB(200, 200, 220)
                    end
                else
                    local name = inputBox and inputBox.Text or ""
                    if name == "" then
                        if resultLabel then
                            resultLabel.Text = "⚠️ Enter a username first"
                            resultLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
                        end
                        return Enum.ContextActionResult.Sink
                    end
                    local target = findPlayerByName(name)
                    if not target then
                        if resultLabel then
                            resultLabel.Text = "❌ Player not found: " .. name
                            resultLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
                        end
                        return Enum.ContextActionResult.Sink
                    end
                    startSpam(name)
                    if spamBtn then
                        spamBtn.Text = "ON"
                        spamBtn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
                    end
                    if resultLabel then
                        resultLabel.Text = "🔁 Spam grabbing " .. target.Name .. " (keybind)"
                        resultLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                    end
                end
                return Enum.ContextActionResult.Sink
            end

            if which == "tp" then
                local name = inputBox and inputBox.Text or ""
                if name == "" then
                    if resultLabel then
                        resultLabel.Text = "⚠️ Enter a username first"
                        resultLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
                    end
                    return Enum.ContextActionResult.Sink
                end
                local target = findPlayerByName(name)
                if not target then
                    if resultLabel then
                        resultLabel.Text = "❌ Player not found: " .. name
                        resultLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
                    end
                    return Enum.ContextActionResult.Sink
                end
                if resultLabel then
                    resultLabel.Text = "🔄 Grabbing " .. target.Name .. " (keybind)..."
                    resultLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
                end
                task.spawn(function()
                    local ok = teleportAndGrab(target)
                    if resultLabel then
                        if ok then
                            resultLabel.Text = "✅ Grabbed " .. target.Name .. " (keybind)"
                            resultLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                        else
                            resultLabel.Text = "❌ Grab failed — check output"
                            resultLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
                        end
                    end
                end)
                return Enum.ContextActionResult.Sink
            end

            return Enum.ContextActionResult.Pass
        end,
        false,
        4000,
        key
    )
    print("[HUS] Bound", key.Name, "→", which)
end

local function beginCapture(which)
    pcall(function() ContextActionService:UnbindAction(CAPTURE_ACTION) end)
    capturingFor = which

    local btn = (which == "spam") and spamKeyBtn or tpKeyBtn
    if btn then
        btn.Text = "PRESS KEY..."
        btn.BackgroundColor3 = Color3.fromRGB(255, 180, 0)
    end

    local allKeys = {}
    for _, kc in ipairs(Enum.KeyCode:GetEnumItems()) do
        table.insert(allKeys, kc)
    end

    ContextActionService:BindActionAtPriority(
        CAPTURE_ACTION,
        function(_, state, input)
            if state ~= Enum.UserInputState.Begin then
                return Enum.ContextActionResult.Pass
            end
            local key = input.KeyCode
            if key == Enum.KeyCode.Unknown then
                return Enum.ContextActionResult.Pass
            end

            if key == Enum.KeyCode.Escape then
                capturingFor = nil
                pcall(function() ContextActionService:UnbindAction(CAPTURE_ACTION) end)
                refreshKeyBtn(which)
                if resultLabel then
                    resultLabel.Text = "⌨️ Keybind cancelled"
                    resultLabel.TextColor3 = Color3.fromRGB(200, 200, 220)
                end
                return Enum.ContextActionResult.Sink
            end

            bindAction(which, key)
            capturingFor = nil
            pcall(function() ContextActionService:UnbindAction(CAPTURE_ACTION) end)
            refreshKeyBtn(which)
            if resultLabel then
                resultLabel.Text = "⌨️ Bound " .. key.Name .. " to " .. which
                resultLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            end
            return Enum.ContextActionResult.Sink
        end,
        false,
        9999,
        table.unpack(allKeys)
    )
end

