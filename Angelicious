local function createToggle(labelText, defaultValue, callback, featureKey)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -6, 0, 24)
    row.BackgroundTransparency = 1
    row.Parent = scrollFrame

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -30, 1, 0)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 120)
    btn.Text = " " .. labelText .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.BorderSizePixel = 0
    btn.Parent = row
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

    uiButtons[featureKey] = { button = btn, text = labelText }

    if defaultValue then cfg[featureKey] = true; btn.Text = " " .. labelText .. ": ON"; btn.BackgroundColor3 = Color3.fromRGB(0, 150, 0) end

    btn.MouseButton1Click:Connect(function()
        cfg[featureKey] = not cfg[featureKey]
        btn.Text = " " .. labelText .. ": " .. (cfg[featureKey] and "ON" or "OFF")
        btn.BackgroundColor3 = cfg[featureKey] and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(30, 30, 120)
        if callback then callback(cfg[featureKey]) end
    end)

    local bindBtn = Instance.new("TextButton")
    bindBtn.Size = UDim2.new(0, 26, 1, 0)
    bindBtn.Position = UDim2.new(1, -26, 0, 0)
    bindBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 100)
    bindBtn.Text = "bind"
    bindBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    bindBtn.Font = Enum.Font.SourceSans
    bindBtn.TextSize = 10
    bindBtn.BorderSizePixel = 0
    bindBtn.Parent = row
    Instance.new("UICorner", bindBtn).CornerRadius = UDim.new(0, 4)

    bindBtn.MouseButton1Click:Connect(function()
        bindBtn.Text = "..."
        local conn
        conn = UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                bindings[featureKey] = input.KeyCode
                bindBtn.Text = input.KeyCode.Name:sub(1, 3)
                conn:Disconnect()
            end
        end)
    end)
end

