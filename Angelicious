UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    
    -- AutoClicker Selection (Wait for click outside GUI)
    if isSelectingPos and input.UserInputType == Enum.UserInputType.MouseButton1 then
        clickPos = input.Position
        isSelectingPos = false
        cfg.AutoClicker = true
        
        -- Update UI
        if uiButtons["AutoClicker"] then
            uiButtons["AutoClicker"].button.Text = " AutoClicker: ON"
            uiButtons["AutoClicker"].button.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        end
        
        startAutoClicker()
        print("[Hub] AutoClicker locked to position: " .. tostring(clickPos))
        return
    end

    -- Normal Keybinds
    if input.UserInputType == Enum.UserInputType.Keyboard then
        for featureKey, keyCode in pairs(bindings) do
            if input.KeyCode == keyCode then
                
                cfg[featureKey] = not cfg[featureKey]
                
                if uiButtons[featureKey] then
                    local uiData = uiButtons[featureKey]
                    uiData.button.Text = " " .. uiData.text .. ": " .. (cfg[featureKey] and "ON" or "OFF")
                    uiData.button.BackgroundColor3 = cfg[featureKey] and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(30, 30, 120)
                end

                if featureKey == "KillAura" then 
                    if cfg.KillAura then startKillAura() else if kaConn then kaConn:Disconnect() end end
                elseif featureKey == "AutoGrab" then
                    if cfg.AutoGrab then startAutoGrab() else if agConn then agConn:Disconnect() end end
                elseif featureKey == "AutoClicker" then
                    if cfg.AutoClicker then 
                        if clickPos then startAutoClicker() else setupAutoClicker() end
                    else 
                        if autoclickerConn then autoclickerConn:Disconnect() end 
                    end
                elseif featureKey == "FlyJump" then
                    if cfg.FlyJump then startFlyJump() else if flyJumpConn then flyJumpConn:Disconnect() end end
                elseif featureKey == "HitboxAura" then
                    if cfg.HitboxAura then startHitboxAura() else if hbAuraConn then hbAuraConn:Disconnect() end end
                elseif featureKey == "MultiHitbox" then
                    if cfg.MultiHitbox then startMultiHitbox() else if multiHitboxConn then multiHitboxConn:Disconnect() end end
                elseif featureKey == "GymBan" then
                    if cfg.GymBan then startGymBan() else if gymBanConn then gymBanConn:Disconnect() end end
                elseif featureKey == "Freeze" then
                    if cfg.Freeze then startFreeze() else if freezeConn then freezeConn:Disconnect() end end
                elseif featureKey == "ForceField" then
                    if cfg.ForceField then startForcefield() else if forcefieldConn then forcefieldConn:Disconnect() end end
                elseif featureKey == "AuraVisuals" then
                    if cfg.AuraVisuals then startAuraVisuals() else if auraVisualsConn then auraVisualsConn:Disconnect() end end
                end
                
                print("[Bind] Toggled " .. featureKey .. " -> " .. (cfg[featureKey] and "ON" or "OFF"))
            end
        end
    end
end)

