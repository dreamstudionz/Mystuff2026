local function startGymBan()
    if gymBanConn then gymBanConn:Disconnect() end
    gymBanConn = RunService.Heartbeat:Connect(function()
        if not cfg.GymBan then return end
        local banList = cfg.GymBanList or ""
        local bannedUsers = {}
        for name in banList:gmatch("[^%s]+") do bannedUsers[name:lower()] = true end
        for _, p in Players:GetPlayers() do
            if p == LocalPlayer or not p.Character then continue end
            if bannedUsers[p.Name:lower()] then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    pcall(function()
                        hrp.CFrame = CFrame.new(hrp.Position.X, 1000, hrp.Position.Z)
                        hrp.AssemblyLinearVelocity = Vector3.new(0, -50, 0)
                    end)
                end
            end
        end
    end)
end

local function startFreeze()
    if freezeConn then freezeConn:Disconnect() end
    freezeConn = RunService.Heartbeat:Connect(function()
        if not cfg.Freeze then return end
        local targetName = cfg.InstaTarget or ""
        if targetName == "" then return end
        for _, p in Players:GetPlayers() do
            if p.Name:lower() == targetName:lower() then
                local hu = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
                if hu then
                    pcall(function()
                        hu.WalkSpeed = 0
                        hu.JumpPower = 0
                    end)
                end
            end
        end
    end)
end

