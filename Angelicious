-- 🔄 GLOBAL HEARTBEAT LOOPS
-- ============================================
RunService.Heartbeat:Connect(function()
    local ch = LocalPlayer.Character
    if not ch then return end
    local hu = ch:FindFirstChildOfClass("Humanoid")
    local hrp = ch:FindFirstChild("HumanoidRootPart")

    if cfg.AntiRagdoll and hu then
        pcall(function() hu:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false) end)
        hu.PlatformStand = false
    end

    if cfg.NoSlow and hu then
        hu.WalkSpeed = 50
        hu.JumpPower = 50
    end

    if cfg.AntiVoid and hrp and hrp.Position.Y < -260 then
        hrp.CFrame = CFrame.new(hrp.Position.X, 50, hrp.Position.Z)
        hrp.AssemblyLinearVelocity = Vector3.zero
    end

    if cfg.AntiGrab then
        for _, v in ipairs(ch:GetDescendants()) do
            if v:IsA("Motor6D") or v:IsA("Weld") then
                local p0Mine = v.Part0 and v.Part0:IsDescendantOf(ch)
                local p1Mine = v.Part1 and v.Part1:IsDescendantOf(ch)
                if (p0Mine and not p1Mine) or (p1Mine and not p0Mine) then v:Destroy() end
            end
        end
    end

    if cfg.Invisible then
        for _, v in ipairs(ch:GetDescendants()) do
            if v:IsA("BasePart") then v.Transparency = 1 end
        end
    elseif cfg.Visible then
        for _, v in ipairs(ch:GetDescendants()) do
            if v:IsA("BasePart") then v.Transparency = 0 end
        end
    end
end)

