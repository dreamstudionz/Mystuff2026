local function startKillAura()
    if kaConn then kaConn:Disconnect() end
    kaConn = RunService.Heartbeat:Connect(function()
        if not cfg.KillAura or not HitRF then return end
        local myChar = LocalPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end
        local nearest = nil
        local nearDist = 50
        for _, p in Players:GetPlayers() do
            if p == LocalPlayer or not p.Character then continue end
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local dist = (hrp.Position - myHRP.Position).Magnitude
                if dist <= nearDist then
                    nearDist = dist
                    nearest = { hum = hum, pos = hrp.Position + hrp.CFrame.LookVector * 2 }
                end
            end
        end
        if nearest then
            pcall(function()
                if HitRF:IsA("RemoteFunction") then HitRF:InvokeServer(nearest.hum, Vector3.new(nearest.pos.X, nearest.pos.Y, nearest.pos.Z))
                else HitRF:FireServer(nearest.hum, Vector3.new(nearest.pos.X, nearest.pos.Y, nearest.pos.Z)) end
            end)
        end
    end)
end

local function startAutoGrab()
    if agConn then agConn:Disconnect() end
    agConn = RunService.Heartbeat:Connect(function()
        if not cfg.AutoGrab or not (GrabRF or CarryRF) then return end
        local myChar = LocalPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end
        local targetRF = GrabRF or CarryRF
        for _, p in Players:GetPlayers() do
            if p == LocalPlayer or not p.Character then continue end
            local theirHRP = p.Character:FindFirstChild("HumanoidRootPart")
            if theirHRP and (theirHRP.Position - myHRP.Position).Magnitude <= 30 then
                pcall(function()
                    if targetRF:IsA("RemoteFunction") then targetRF:InvokeServer(p) else targetRF:FireServer(p) end
                end)
                break
            end
        end
    end)
end

local function startFlyJump()
    if flyJumpConn then flyJumpConn:Disconnect() end
    local jumpConn = LocalPlayer.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        local hu = char:FindFirstChildOfClass("Humanoid")
        if not hu then return end
        flyJumpConn = hu.StateChanged:Connect(function(_, newState)
            if cfg.FlyJump and newState == Enum.HumanoidStateType.Jumping then
                task.wait(0.1)
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local bv = Instance.new("BodyVelocity")
                    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                    bv.Velocity = Vector3.new(0, 50, 0)
                    bv.Parent = hrp
                    game:GetService("Debris"):AddItem(bv, 0.5)
                end
            end
        end)
    end)
    if LocalPlayer.Character then jumpConn:Fire(LocalPlayer.Character) end
end

