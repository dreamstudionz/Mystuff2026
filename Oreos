            elseif n == "setrpnamecolor" or n == "updaterpnamecolor" or n == "setnamecolor"
                or n == "updaterpcolor" or n == "updatenamecolor" or n == "setrpcolor"
                or n == "namecolor" or n == "changerpnamecolor" or n == "rpnamecolor" then
