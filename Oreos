    local function removeDistanceLabel(player)
        local label = distanceLabels[player]
        if label then
            pcall(function() label:Destroy() end)
            distanceLabels[player] = nil
        end
    end

    local function updateAllDistances()
        local myChar = LocalPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end

        for _, p in Players:GetPlayers() do
            if p == LocalPlayer then continue end
            local theirChar = p.Character
            if not theirChar then
                removeDistanceLabel(p)
                continue
            end
            local theirHRP = theirChar:FindFirstChild("HumanoidRootPart")
            local theirHead = theirChar:FindFirstChild("Head")
            local theirHu = theirChar:FindFirstChildOfClass("Humanoid")

            if not theirHRP or not theirHead or (theirHu and theirHu.Health <= 0) then
                removeDistanceLabel(p)
                continue
            end

            local label = distanceLabels[p] or createDistanceLabel(p)
            if not label then continue end

            if label.Parent ~= theirHead then
                removeDistanceLabel(p)
                label = createDistanceLabel(p)
                if not label then continue end
            end

            local dist = (theirHRP.Position - myHRP.Position).Magnitude
            local bg = label:FindFirstChild("BG")
            if bg then
                local nameLabel = bg:FindFirstChild("NameText")
                local textLabel = bg:FindFirstChild("DistanceText")

                if nameLabel then
                    nameLabel.Text = p.DisplayName ~= "" and p.DisplayName or p.Name
                end

                if textLabel then
                    textLabel.Text = string.format("%d studs", math.floor(dist))

                    if dist < 10 then
                        textLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                    elseif dist < 30 then
                        textLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
                    elseif dist < 100 then
                        textLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                    else
                        textLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
                    end
                end
            end
        end
    end

