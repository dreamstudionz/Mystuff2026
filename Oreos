    local fpsConn, lastFPSKill, savedLighting, savedPostEffects = nil, 0, {}, {}
    local function applyFPSBoost()
        local Lighting = game:GetService("Lighting")
        savedLighting = { GlobalShadows = Lighting.GlobalShadows, Brightness = Lighting.Brightness, FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart }
        pcall(function() Lighting.GlobalShadows = false; Lighting.FogEnd = 100000; Lighting.FogStart = 100000 end)
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") or v:IsA("Atmosphere") then pcall(function() savedPostEffects[v] = v.Enabled; v.Enabled = false end) end
        end
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") or v:IsA("Trail") or v:IsA("Beam") then
                pcall(function() v.Enabled = false end)
