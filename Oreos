                    local c = p.Character
                    if c then
                        local hu = c:FindFirstChild("Humanoid")
                        local thrp = c:FindFirstChild("HumanoidRootPart")
                        if hu and thrp and hu.Health > 0 then
                            if (thrp.Position - hrp.Position).Magnitude <= Settings.KARange then
                                pcall(function()
                                    if HitRF:IsA("RemoteFunction") then HitRF:InvokeServer(hu, hrp.Position)
                                    else HitRF:FireServer(hu, hrp.Position) end
                                end)
