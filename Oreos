    local TeleportService = game:GetService("TeleportService")

    local function teleportToPlayerServer(username)
        if not username or username == "" then
            Rayfield:Notify({ Title = "🌐 Server Hop", Content = "Enter a username first", Duration = 3, Image = 4483362458 })
            return
        end

        Rayfield:Notify({ Title = "🌐 Server Hop", Content = "Looking up " .. username .. "...", Duration = 3, Image = 4483362458 })

        task.spawn(function()
            local ok, err = pcall(function()
                local userId = Players:GetUserIdFromNameAsync(username)
                print("[ServerHop] UserId:", userId)

                local body = HttpService:JSONEncode({ userIds = { userId } })
                local req = syn and syn.request or http_request or request
                if not req then error("No HTTP function available") end

                local res = req({
                    Url = "https://presence.roblox.com/v1/presence/users",
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = body
                })

                print("[ServerHop] Raw:", res.Body)

                local data = HttpService:JSONDecode(res.Body)
                local presence = data.userPresences and data.userPresences[1]
                if not presence or not presence.placeId or not presence.gameId then
                    error("Player not in a joinable game (privacy or offline)")
                end

                print("[ServerHop] Teleporting to", presence.placeId, presence.gameId)
                TeleportService:TeleportToPlaceInstance(presence.placeId, presence.gameId, LocalPlayer)

                Rayfield:Notify({ Title = "🌐 Server Hop", Content = "Joining " .. username .. "'s server...", Duration = 5, Image = 4483362458 })
                sendWebhookLog("🌐 Server Hop", "Teleported to **" .. username .. "**'s server", 5763719)
            end)

            if not ok then
                print("[ServerHop] ❌ Error:", err)
                Rayfield:Notify({ Title = "🌐 Server Hop", Content = "Failed: " .. tostring(err), Duration = 5, Image = 4483362458 })
            end
        end)
    end

