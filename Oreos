    local skySafeEnabled = false
    local skyPlatformManual = nil
    local skyOriginalPos = nil
    local skyHeartbeatConn = nil
    local SKY_HEIGHT = 500

    local function createSkyPlatformManual(position)
        local plat = Instance.new("Part")
        plat.Name = "Oreo_SkySafe"
        plat.Size = Vector3.new(200, 1, 200)
        plat.Anchored = true
        plat.CanCollide = true
        plat.Transparency = 1
        plat.CanQuery = false
        plat.CanTouch = false
        plat.Material = Enum.Material.SmoothPlastic
        plat.CFrame = CFrame.new(position)
        plat.Parent = workspace

        local outline = Instance.new("SelectionBox")
        outline.Name = "SkyOutline"
        outline.Adornee = plat
        outline.LineThickness = 0.1
        outline.Color3 = Color3.fromRGB(120, 200, 255)
        outline.Transparency = 0.7
        outline.Parent = plat

        return plat
    end

    local function enableSkySafe()
        local myChar = LocalPlayer.Character
        local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not hrp then
            Rayfield:Notify({ Title = "☁️ SkySafe", Content = "You need a character first", Duration = 3, Image = 4483362458 })
            return
        end

        skyOriginalPos = hrp.CFrame
        if skyPlatformManual then skyPlatformManual:Destroy() end
        skyPlatformManual = createSkyPlatformManual(Vector3.new(hrp.Position.X, hrp.Position.Y + SKY_HEIGHT, hrp.Position.Z))
        hrp.CFrame = CFrame.new(skyPlatformManual.Position + Vector3.new(0, 5, 0))

        if skyHeartbeatConn then skyHeartbeatConn:Disconnect() end
        skyHeartbeatConn = RunService.Heartbeat:Connect(function()
            if not skySafeEnabled then return end
            local ch = LocalPlayer.Character
            local r = ch and ch:FindFirstChild("HumanoidRootPart")
            if not r or not skyPlatformManual then return end
            if r.Position.Y < skyPlatformManual.Position.Y - 10 then
                r.CFrame = CFrame.new(skyPlatformManual.Position + Vector3.new(0, 5, 0))
                r.AssemblyLinearVelocity = Vector3.zero
            end
        end)

        Rayfield:Notify({ Title = "☁️ SkySafe", Content = "You're safe in the sky!", Duration = 4, Image = 4483362458 })
        sendWebhookLog("☁️ SkySafe", "Enabled SkySafe Zone", 5763719)
    end

    local function disableSkySafe()
        if skyHeartbeatConn then skyHeartbeatConn:Disconnect(); skyHeartbeatConn = nil end
        if skyPlatformManual then skyPlatformManual:Destroy(); skyPlatformManual = nil end
        local ch = LocalPlayer.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if hrp and skyOriginalPos then
            pcall(function()
                hrp.CFrame = skyOriginalPos
                hrp.AssemblyLinearVelocity = Vector3.zero
            end)
        end
        skyOriginalPos = nil
        Rayfield:Notify({ Title = "☁️ SkySafe", Content = "SkySafe disabled", Duration = 3, Image = 4483362458 })
        sendWebhookLog("☁️ SkySafe", "Disabled SkySafe Zone", 15548997)
    end

    SettingsTab:CreateToggle({
        Name = "☁️ SkySafe Zone (Safe in the sky)",
        CurrentValue = false,
        Flag = "SkySafeToggle",
        Callback = function(v)
            PlayClickSound()
            skySafeEnabled = v
            if v then enableSkySafe() else disableSkySafe() end
        end
    })

    SettingsTab:CreateLabel("⬆️ Teleports you high in the sky on an invisible platform")

    SettingsTab:CreateSlider({
        Name = "Sky Height",
        Range = {100, 2000}, Increment = 50, Suffix = "studs",
        CurrentValue = 500, Flag = "SkyHeight",
        Callback = function(v)
            SKY_HEIGHT = v
            if skySafeEnabled and skyPlatformManual then
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    skyPlatformManual.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y + SKY_HEIGHT, hrp.Position.Z)
                    hrp.CFrame = CFrame.new(skyPlatformManual.Position + Vector3.new(0, 5, 0))
                end
            end
        end
    })

    SettingsTab:CreateDivider()
    SettingsTab:CreateSection("About")
    SettingsTab:CreateLabel("🍪 Oreo's Hub")
    SettingsTab:CreateLabel("Made by Oreo")
    SettingsTab:CreateLabel("Discord: @oreo.fv")

    Rayfield:Notify({
        Title = "🍪 Oreo's Hub",
        Content = "Hub loaded successfully!",
        Duration = 5,
        Image = 4483362458
    })

    print("🍪 Oreo's Hub LOADED")
end

