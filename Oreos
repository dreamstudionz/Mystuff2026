        end
    end
    local function restoreFPSBoost()
        local Lighting = game:GetService("Lighting")
        pcall(function() for k, v in pairs(savedLighting) do Lighting[k] = v end end)
        for effect, wasEnabled in pairs(savedPostEffects) do pcall(function() if effect.Parent then effect.Enabled = wasEnabled end end) end
    end
