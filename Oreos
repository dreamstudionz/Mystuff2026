    local function createSkyPlatform(position)
        if skyPlatform then skyPlatform:Destroy() end
        local plat = Instance.new("Part")
        plat.Name = "Oreo_SkySafe_AutoExit"
        plat.Size = Vector3.new(200, 1, 200)
