                ["footer"] = { ["text"] = "🍪 Oreo's Hub Logger • " .. os.date("%Y-%m-%d %H:%M:%S") }
            }}
            request({
                Url = CONFIG.WebhookURL, Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({ username = "Oreo's Hub Logger", embeds = embed })
            })
        end)
    end)
end

