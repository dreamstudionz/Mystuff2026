        if kaConn then kaConn:Disconnect() end
        kaConn = RunService.Heartbeat:Connect(function()
            if not Toggles.KillAura or not HitRF then return end
            local mc = LocalPlayer.Character
            local hrp = mc and mc:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local tl = parseList(Settings.KATargets)
