        outline.Adornee = plat
        outline.LineThickness = 0.1
        outline.Color3 = Color3.fromRGB(120, 200, 255)
        outline.Transparency = 0.7
        outline.Parent = plat

        skyPlatform = plat
    end

    local function destroySkyPlatform()
        if skyPlatform then
            skyPlatform:Destroy()
            skyPlatform = nil
        end
    end

    local function autoExitSound()
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://9120386436"
        s.Volume = 5
        s.Parent = game:GetService("SoundService")
        s:Play()
        game:GetService("Debris"):AddItem(s, 2)
    end

    local function teleportToSkySafe(reason)
        local ch = LocalPlayer.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        if tick() - autoExitCooldown < 3 then return end

        autoExitCooldown = tick()
        print("[AutoExit] >>> TELEPORTING TO SKYSAFE! Reason:", reason)

        savedGymPosition = hrp.Position
        autoExitSound()

        local safePos = Vector3.new(
            hrp.Position.X,
            hrp.Position.Y + Settings.AutoExitSkyHeight,
            hrp.Position.Z
        )
        createSkyPlatform(safePos)
        isInSkySafe = true

        pcall(function()
            hrp.CFrame = CFrame.new(safePos + Vector3.new(0, 5, 0))
            hrp.AssemblyLinearVelocity = Vector3.zero
        end)
    end

    local function returnToGym(reason)
        local ch = LocalPlayer.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        if tick() - autoExitCooldown < 3 then return end

        autoExitCooldown = tick()
        print("[AutoExit] >>> RETURNING TO GYM! Reason:", reason)

        autoExitSound()
        destroySkyPlatform()
        isInSkySafe = false

        local target = savedGymPosition or Settings.GymPosition
        pcall(function()
            hrp.CFrame = CFrame.new(target + Vector3.new(0, 3, 0))
            hrp.AssemblyLinearVelocity = Vector3.zero
        end)
        savedGymPosition = nil
    end

    local function startAutoExitLowHP()
        if autoExitConn then autoExitConn:Disconnect(); autoExitConn = nil end

        autoExitConn = RunService.Heartbeat:Connect(function()
            if not Toggles.AutoExitLowHP then return end

            local ch = LocalPlayer.Character
            local hu = ch and ch:FindFirstChildOfClass("Humanoid")
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if not hu or not hrp then return end

            if isInSkySafe and skyPlatform and hrp.Position.Y < skyPlatform.Position.Y - 10 then
                pcall(function()
                    hrp.CFrame = CFrame.new(skyPlatform.Position + Vector3.new(0, 5, 0))
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end)
            end

            if not isInSkySafe and hu.Health > 0 and hu.Health < Settings.AutoExitHPThreshold then
                teleportToSkySafe("HP=" .. math.floor(hu.Health))
            end

            if isInSkySafe and hu.Health >= Settings.AutoExitReturnHP then
                returnToGym("HP=" .. math.floor(hu.Health))
            end
        end)
    end

    local function stopAutoExitLowHP()
        if autoExitConn then autoExitConn:Disconnect(); autoExitConn = nil end
        destroySkyPlatform()
        isInSkySafe = false
        savedGymPosition = nil
    end

    -- ============================================
    -- ⚡ FPS BOOSTER SYSTEM
    -- ============================================
    local fpsConn = nil
    local lastFPSKill = 0
    local savedLighting = {}
    local savedPostEffects = {}

    local function applyFPSBoost()
        local Lighting = game:GetService("Lighting")
        savedLighting = {
            GlobalShadows = Lighting.GlobalShadows,
            Brightness = Lighting.Brightness,
            FogEnd = Lighting.FogEnd,
            FogStart = Lighting.FogStart,
        }
        savedPostEffects = {}
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
                pcall(function()
                    if v.Enabled ~= nil then
                        savedPostEffects[v] = v.Enabled
                        v.Enabled = false
                    end
                end)
            end
        end

        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 100000
            Lighting.FogStart = 100000
        end)

        local countP = 0
        local countE = 0
        local countD = 0
        local countL = 0

        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ParticleEmitter") then
                pcall(function() v.Enabled = false; countP = countP + 1 end)
            elseif v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles")
                or v:IsA("Trail") or v:IsA("Beam") then
                pcall(function() v.Enabled = false; countE = countE + 1 end)
            elseif v:IsA("Decal") or v:IsA("Texture") then
                pcall(function() v.Transparency = 1; countD = countD + 1 end)
            elseif v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight") then
                pcall(function()
                    if v.Enabled then v.Enabled = false; countL = countL + 1 end
                end)
            end
        end

        print(string.format("[FPS] Boost applied — %d particles, %d effects, %d decals, %d lights disabled",
            countP, countE, countD, countL))
    end

    local function restoreFPSBoost()
        local Lighting = game:GetService("Lighting")
        pcall(function()
            for k, v in pairs(savedLighting) do
                Lighting[k] = v
            end
        end)
        for effect, wasEnabled in pairs(savedPostEffects) do
            pcall(function()
                if effect.Parent then effect.Enabled = wasEnabled end
            end)
        end
        savedPostEffects = {}
        print("[FPS] Restored lighting (rejoin for particles)")
    end

    local function startFPSBooster()
        if fpsConn then fpsConn:Disconnect(); fpsConn = nil end
        applyFPSBoost()

        fpsConn = RunService.Heartbeat:Connect(function()
            if not Toggles.FPSBooster then return end
            if tick() - lastFPSKill > 2 then
                lastFPSKill = tick()
                local Lighting = game:GetService("Lighting")
                for _, v in ipairs(Lighting:GetChildren()) do
                    if v:IsA("PostEffect") and v.Enabled then
                        pcall(function() v.Enabled = false end)
                    end
                end
                for _, v in ipairs(workspace:GetDescendants()) do
                    if v:IsA("ParticleEmitter") and v.Enabled then
                        pcall(function() v.Enabled = false end)
                    end
                end
            end
        end)
    end

    local function stopFPSBooster()
        if fpsConn then fpsConn:Disconnect(); fpsConn = nil end
        restoreFPSBoost()
    end

