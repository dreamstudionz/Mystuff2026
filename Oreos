    local flyBodyGyro = nil
    local savedAnimations = {}
    local jumpConn = nil
    local stateConn = nil

    local function setIdleAnimation()
        local ch = LocalPlayer.Character
        if not ch then return end
        local animate = ch:FindFirstChild("Animate")
        if not animate then return end
        savedAnimations = {}
        for _, name in ipairs({"walk", "run"}) do
            local folder = animate:FindFirstChild(name)
            if folder then
                local anim = folder:FindFirstChildOfClass("Animation")
                if anim then
                    savedAnimations[name] = anim.AnimationId
                    anim.AnimationId = "rbxassetid://0"
                end
            end
        end
    end

    local function restoreAnimations()
        local ch = LocalPlayer.Character
        if not ch then return end
        local animate = ch:FindFirstChild("Animate")
        if not animate then return end
        for name, originalId in pairs(savedAnimations) do
            local folder = animate:FindFirstChild(name)
            if folder then
                local anim = folder:FindFirstChildOfClass("Animation")
                if anim then anim.AnimationId = originalId end
            end
        end
        savedAnimations = {}
    end

    local function applySpeed()
        local ch = LocalPlayer.Character
        local hu = ch and ch:FindFirstChildOfClass("Humanoid")
        if hu then
            hu.WalkSpeed = Toggles.SpeedFlyEnabled and Settings.WalkSpeed or 16
        end
    end

    local function startFlyLoop()
        if flyConn then flyConn:Disconnect() end
        local ch = LocalPlayer.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        if Toggles.FlyMode then
            flyConn = RunService.Heartbeat:Connect(function(dt)
                if not Toggles.FlyActive then return end
                local c = LocalPlayer.Character
                local r = c and c:FindFirstChild("HumanoidRootPart")
                local h = c and c:FindFirstChildOfClass("Humanoid")
                if not r or not h then return end
                local direction = h.MoveDirection
                local vertical = 0
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vertical = 1
                elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vertical = -1 end
                local final = direction + Vector3.new(0, vertical, 0)
                if final.Magnitude > 0 then
                    final = final.Unit
                    r.CFrame = r.CFrame + (final * Settings.FlySpeed * dt)
                end
                r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end)
        else
            flyBodyVelocity = Instance.new("BodyVelocity")
            flyBodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            flyBodyVelocity.Velocity = Vector3.zero
            flyBodyVelocity.Parent = hrp

            flyBodyGyro = Instance.new("BodyGyro")
            flyBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            flyBodyGyro.P = 9e4
            flyBodyGyro.CFrame = hrp.CFrame
            flyBodyGyro.Parent = hrp

            flyConn = RunService.Heartbeat:Connect(function()
                if not Toggles.FlyActive then return end
                local c = LocalPlayer.Character
                local r = c and c:FindFirstChild("HumanoidRootPart")
                local h = c and c:FindFirstChildOfClass("Humanoid")
                if not r or not h then return end
                local direction = h.MoveDirection
                local vertical = 0
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vertical = 1
                elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vertical = -1 end
                flyBodyVelocity.Velocity = (direction * Settings.FlySpeed) + Vector3.new(0, vertical * Settings.FlySpeed, 0)
                flyBodyGyro.CFrame = workspace.CurrentCamera.CFrame
            end)
        end
    end

    local function stopFlyLoop()
        if flyConn then flyConn:Disconnect(); flyConn = nil end
        if flyBodyVelocity then flyBodyVelocity:Destroy(); flyBodyVelocity = nil end
        if flyBodyGyro then flyBodyGyro:Destroy(); flyBodyGyro = nil end
    end

    local function activateFly()
        if not Toggles.SpeedFlyEnabled then return end
        if Toggles.FlyActive then return end
        Toggles.FlyActive = true
        setIdleAnimation()
        startFlyLoop()
    end

    local function deactivateFly()
        if not Toggles.FlyActive then return end
        Toggles.FlyActive = false
        stopFlyLoop()
        restoreAnimations()
    end

    local function hookCharacter(ch)
        if jumpConn then jumpConn:Disconnect() end
        if stateConn then stateConn:Disconnect() end
        local hu = ch:WaitForChild("Humanoid", 5)
        if not hu then return end
        jumpConn = hu.Jumping:Connect(function()
            if Toggles.SpeedFlyEnabled then
                task.wait(Settings.FlyHoldTime)
                if hu:GetState() ~= Enum.HumanoidStateType.Landed and Toggles.SpeedFlyEnabled then
                    activateFly()
                end
            end
        end)
        stateConn = hu.StateChanged:Connect(function(_, newState)
            if newState == Enum.HumanoidStateType.Landed
               or newState == Enum.HumanoidStateType.Running
               or newState == Enum.HumanoidStateType.RunningNoPhysics then
                if Toggles.FlyActive then deactivateFly() end
            end
        end)
    end

    LocalPlayer.CharacterAdded:Connect(function(ch)
        task.wait(0.5)
        hookCharacter(ch)
        if Toggles.SpeedFlyEnabled then applySpeed() end
    end)

    if LocalPlayer.Character then hookCharacter(LocalPlayer.Character) end

