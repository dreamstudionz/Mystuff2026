local function sendWebhookLog(title, message, color)
    if not CONFIG.LogEnabled then return end
    if CONFIG.WebhookURL == "YOUR_NEW_WEBHOOK_URL_HERE" then return end
    task.spawn(function()
        pcall(function()
            local embed = {{
                ["title"] = title,
                ["description"] = message,
                ["color"] = color or 3447003,
                ["fields"] = {
                    { ["name"] = "👤 Username", ["value"] = "`" .. LocalPlayer.Name .. "`", ["inline"] = true },
