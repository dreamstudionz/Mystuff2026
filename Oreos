    local escapeGrabConn = nil
    local escapeGrabFlag = false
    local grabCooldown = 0
    local grabConfirmCount = 0
    local lastIGrabbedTime = 0

    local function escapeFromGrab(reason)
        if escapeGrabFlag then return end
        if tick() - grabCooldown < 2 then return end
        grabCooldown = tick()
        escapeGrabFlag = true
        print("[EscapeGrab] >>> RESETTING! Reason:", reason)

        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://9120386436"
        s.Volume = 7
        s.Parent = game:GetService("SoundService")
        s:Play()
        game:GetService("Debris"):AddItem(s, 3)

        pcall(function()
            local ch = LocalPlayer.Character
            if ch then
                local hu = ch:FindFirstChildOfClass("Humanoid")
                if hu and hu.Health > 0 then hu.Health = 0 end
            end
        end)

        task.wait(0.5)
        escapeGrabFlag = false
        grabConfirmCount = 0
    end

    local function isGrabbedByOtherPlayer()
        local ch = LocalPlayer.Character
        if not ch then return false, nil end

        if ch:FindFirstChild("GRAB_weld", true) then
            return false, nil
        end

        for _, p in Players:GetPlayers() do
            if p ~= LocalPlayer and p.Character then
                local theirHu = p.Character:FindFirstChildOfClass("Humanoid")
                if theirHu and theirHu.Health > 0 then
                    local grabWeld = p.Character:FindFirstChild("GRAB_weld", true)
                    if grabWeld and (grabWeld:IsA("Weld") or grabWeld:IsA("WeldConstraint")) then
                        local p0 = grabWeld.Part0
                        local p1 = grabWeld.Part1
                        if p0 and p1 then
                            local p0Theirs = p0:IsDescendantOf(p.Character)
                            local p1Theirs = p1:IsDescendantOf(p.Character)
                            local p0Ours = p0:IsDescendantOf(ch)
                            local p1Ours = p1:IsDescendantOf(ch)
                            if (p0Theirs and p1Ours) or (p1Theirs and p0Ours) then
                                return true, p.Name
                            end
                        end
                    end
                end
            end
        end

        return false, nil
    end

    local function startEscapeGrab()
        if escapeGrabConn then escapeGrabConn:Disconnect(); escapeGrabConn = nil end
        grabConfirmCount = 0

        escapeGrabConn = RunService.Heartbeat:Connect(function()
            if not Toggles.EscapeGrab then return end
            if escapeGrabFlag then return end
            if tick() - lastIGrabbedTime < 1.5 then return end

            local grabbed, grabberName = isGrabbedByOtherPlayer()

            if grabbed then
                grabConfirmCount = grabConfirmCount + 1
                if grabConfirmCount >= 3 then
                    escapeFromGrab("GRAB_weld from " .. tostring(grabberName))
                end
            else
                grabConfirmCount = 0
            end
        end)
    end

    local function stopEscapeGrab()
        if escapeGrabConn then escapeGrabConn:Disconnect(); escapeGrabConn = nil end
        grabConfirmCount = 0
    end

