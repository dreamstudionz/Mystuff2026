-- ============================================
-- OREO'S HUB LOADER
-- ============================================
local function loadOreosHub()

    local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

    local function PlayClickSound()
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://91741510066624"
        sound.Volume = 5
        sound.Parent = game:GetService("SoundService")
        sound:Play()
        game:GetService("Debris"):AddItem(sound, 1)
    end

    local SAVE = {}
    local DataFile = "OreosHub.json"
    local function LoadData()
        pcall(function()
            if writefile and isfile(DataFile) then
                local data = HttpService:JSONDecode(readfile(DataFile))
                if type(data) == "table" then
                    for k, v in pairs(data) do SAVE[k] = v end
                end
            end
        end)
    end
    local function SaveData()
        pcall(function()
            if writefile then writefile(DataFile, HttpService:JSONEncode(SAVE)) end
        end)
    end
    local function Get(k, d) return SAVE[k] ~= nil and SAVE[k] or d end
    local function Set(k, v) SAVE[k] = v; SaveData() end
    LoadData()

    local Window = Rayfield:CreateWindow({
        Name = "🍪 Oreo's Hub",
        LoadingTitle = "Oreo's Hub",
        LoadingSubtitle = "Loading...",
        Theme = "Ocean",
        ConfigurationSaving = { Enabled = true, FolderName = "OreosHub", FileName = "Main" },
        KeySystem = false
    })

    sendWebhookLog("🍪 Hub Loaded", "Player loaded **Oreo's Hub**", 5763719)

    -- ============================================
    -- 🔍 FIND REMOTES
    -- ============================================
    local HitRF, GrabRF = nil, nil
    local bioRemote, bioColorRemote, nameRemote, nameColorRemote = nil, nil, nil, nil

    local RemotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
    if RemotesFolder then
        for _, v in pairs(RemotesFolder:GetChildren()) do
            local n = v.Name:lower()
            if n == "setrpname" or n == "updaterpname" or n == "setname" then
                nameRemote = v
            end
            if n == "setrpnamecolor" or n == "updaterpnamecolor" or n == "setnamecolor" then
                nameColorRemote = v
            end
        end
    end

    for _, child in pairs(ReplicatedStorage:GetDescendants()) do
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
            local n = child.Name:lower()
            if n == "hit" or n == "punch" then
                HitRF = child
            elseif n == "grab" then
                GrabRF = child
            elseif n == "updatebio" or n == "setbio" or n == "updatebioname" or n == "setbioname" then
                bioRemote = child
            elseif n == "updatebiocolor" or n == "setbiocolor" or n == "biocolor" then
                bioColorRemote = child
            elseif n == "setrpnamecolor" or n == "updaterpnamecolor" or n == "setnamecolor" then
                if not nameColorRemote then nameColorRemote = child end
            elseif n == "updaterpname" or n == "setrpname" or n == "setname" then
                if not nameRemote then nameRemote = child end
            end
        end
    end

    -- ============================================
    -- STATE
    -- ============================================
    local function parseList(str)
        local t = {}
        if str == "" then return t end
        for w in str:gmatch("%S+") do table.insert(t, w:lower()) end
        return t
    end
    local function isTarget(n, list)
        if #list == 0 then return true end
        for _, v in ipairs(list) do if n:lower():find(v, 1, true) then return true end end
        return false
    end
    local function isSafe(n, list)
        for _, v in ipairs(list) do if n:lower():find(v, 1, true) then return true end end
        return false
    end

    local Toggles = {
        KillAura = false, SpamGrab = false, Hitbox = false,
        AntiRag = true, AntiFling = false, AntiAFK = true, AntiVoid = false,
        EscapeGrab = false,
        SpeedFlyEnabled = false, FlyActive = false, FlyMode = false,
        Orbit = false, Headsit = false, Attach = false, MouthBang = false, Bang = false,
        GlowBio = false,
        NameGlow = false,
        AutoTarget = false,
        TpGrabLoop = false,
    }
    local Settings = {
        KARange = 50, HitboxSize = 10,
        KATargets = Get("KATargets", ""),
        KASafe    = Get("KASafe", ""),
        WalkSpeed = 50, FlySpeed = 100, FlyHoldTime = 0.15,
        BangTarget = "", BangSpeed = 1,
        BioColorMode = "black_white",
        BioCustomColor = Color3.fromRGB(255, 255, 255),
        BioSpeed = 5,
        BioText = "🍪 Oreo's Hub 🍪",
        RPNameText = "Oreo",
        LastRPColor = Color3.fromRGB(255, 255, 255),
        GrabTarget1 = "",
        GrabTarget2 = "",
        GrabDistance = 3,
        AutoTargetRange = 50,
    }

    -- ============================================
    -- ✨ GLOWING BIO + NAME SYSTEM
    -- ============================================
    local bioConn = nil
    local lastBioColor = nil
    local lastRPColor = nil
    local rpNameSetOnce = false
    local lastBioText = nil

    local function applyBioText(text)
        if not bioRemote then return end
        if lastBioText == text then return end
        lastBioText = text
        pcall(function()
            if bioRemote:IsA("RemoteFunction") then bioRemote:InvokeServer(text)
            else bioRemote:FireServer(text) end
        end)
    end

    local function applyBioColor(color)
        if not bioColorRemote then return end
        pcall(function()
            if bioColorRemote:IsA("RemoteFunction") then bioColorRemote:InvokeServer(color)
            else bioColorRemote:FireServer(color) end
        end)
    end

    local function applyRPNameTextOnce(text)
        if not nameRemote then return end
        if rpNameSetOnce then return end
        rpNameSetOnce = true
        pcall(function()
            if nameRemote:IsA("RemoteFunction") then nameRemote:InvokeServer(text)
            else nameRemote:FireServer(text) end
        end)
    end

    local function applyRPNameColorOnly(color)
        if not nameColorRemote then return end
        if lastRPColor == color then return end
        lastRPColor = color
        pcall(function()
            if nameColorRemote:IsA("RemoteFunction") then nameColorRemote:InvokeServer(color)
            else nameColorRemote:FireServer(color) end
        end)
    end

    local function applyBioColorOnly(color)
        if lastBioColor == color then return end
        lastBioColor = color
        applyBioColor(color)
    end

    local function applyColors(color)
        applyBioColorOnly(color)
        if Toggles.NameGlow then applyRPNameColorOnly(color) end
    end

    local function startGlowBio()
        if bioConn then bioConn:Disconnect() end
        applyBioText(Settings.BioText)
        if Toggles.NameGlow then applyRPNameTextOnce(Settings.RPNameText) end

        local hue = 0
        local policeState = false
        local lastPoliceSwitch = 0

        bioConn = RunService.Heartbeat:Connect(function(dt)
            if not Toggles.GlowBio then return end
            if Settings.BioColorMode == "black_white" then
                local phase = math.floor(tick() * Settings.BioSpeed) % 2
                if phase == 0 then applyColors(Color3.fromRGB(0, 0, 0))
                else applyColors(Color3.fromRGB(255, 255, 255)) end
            elseif Settings.BioColorMode == "rainbow" then
                hue = (hue + (Settings.BioSpeed * 0.5 * dt)) % 1
                applyColors(Color3.fromHSV(hue, 1, 1))
            elseif Settings.BioColorMode == "police" then
                local now = tick()
                local switchInterval = 1 / Settings.BioSpeed
                if now - lastPoliceSwitch >= switchInterval then
                    policeState = not policeState
                    lastPoliceSwitch = now
                end
                if policeState then applyColors(Color3.fromRGB(255, 0, 0))
                else applyColors(Color3.fromRGB(0, 0, 255)) end
            elseif Settings.BioColorMode == "custom" then
                applyColors(Settings.BioCustomColor)
            end
        end)
    end

    local function stopGlowBio()
        if bioConn then bioConn:Disconnect(); bioConn = nil end
        lastBioColor = nil
        lastRPColor = nil
        lastBioText = nil
        rpNameSetOnce = false
    end

    -- ============================================
    -- 🚨 ESCAPE GRAB SYSTEM (Power Grab only)
    -- ============================================
    local escapeGrabConn = nil
    local escapeGrabFlag = false
    local grabHookConn = nil
    local grabCooldown = 0

    local function escapeFromGrab()
        if escapeGrabFlag then return end
        if tick() - grabCooldown < 1 then return end
        grabCooldown = tick()
        escapeGrabFlag = true

        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://9120386436"
        sound.Volume = 7
        sound.Parent = game:GetService("SoundService")
        sound:Play()
        game:GetService("Debris"):AddItem(sound, 3)

        pcall(function()
            local ch = LocalPlayer.Character
            if ch then
                local hu = ch:FindFirstChildOfClass("Humanoid")
                if hu and hu.Health > 0 then hu.Health = 0 end
            end
        end)

        task.wait(0.5)
        escapeGrabFlag = false
    end

    local function startEscapeGrab()
        -- Disconnect any existing hooks
        if escapeGrabConn then escapeGrabConn:Disconnect(); escapeGrabConn = nil end
        if grabHookConn then grabHookConn:Disconnect(); grabHookConn = nil end

        -- Hook the Grab remote's OnClientEvent — this fires when someone grabs YOU
        if GrabRF then
            grabHookConn = GrabRF.OnClientEvent:Connect(function(...)
                if not Toggles.EscapeGrab then return end
                if escapeGrabFlag then return end

                local args = {...}
                -- Check if any arg references us (player, character, or humanoid)
                for _, a in ipairs(args) do
                    if a == LocalPlayer
                       or a == LocalPlayer.Character
                       or (typeof(a) == "Instance" and a:IsDescendantOf(LocalPlayer.Character or workspace)) then
                        escapeFromGrab()
                        return
                    end
                end

                -- Fallback: if no args matched but event fired, and we ARE being held
                -- (grabbed players usually have near-zero velocity + a weld from someone else)
                local ch = LocalPlayer.Character
                local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                if hrp then
                    for _, v in ipairs(ch:GetDescendants()) do
                        if v:IsA("Weld") or v:IsA("WeldConstraint") or v:IsA("Motor6D") then
                            local p0, p1 = v.Part0, v.Part1
                            if p0 and p1 then
                                local other
                                if p0:IsDescendantOf(ch) then other = p1
                                elseif p1:IsDescendantOf(ch) then other = p0 end
                                if other then
                                    local otherChar = other:FindFirstAncestorOfClass("Model")
                                    if otherChar and otherChar ~= ch then
                                        local otherPlayer = Players:GetPlayerFromCharacter(otherChar)
                                        if otherPlayer and otherPlayer ~= LocalPlayer then
                                            escapeFromGrab()
                                            return
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end

        -- Keep a lightweight heartbeat as backup in case OnClientEvent doesn't include us as arg
        escapeGrabConn = RunService.Heartbeat:Connect(function()
            if not Toggles.EscapeGrab then return end
            if escapeGrabFlag then return end
            -- Don't trigger if we're the one grabbing
            if Toggles.SpamGrab then return end

            local ch = LocalPlayer.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            local hu = ch and ch:FindFirstChildOfClass("Humanoid")
            if not hrp or not hu then return end

            -- Only look for welds on our upper body / HRP (power grab signature)
            for _, v in ipairs(ch:GetDescendants()) do
                if v:IsA("Weld") or v:IsA("WeldConstraint") or v:IsA("Motor6D") then
                    local p0, p1 = v.Part0, v.Part1
                    if p0 and p1 then
                        local ourSide, otherSide
                        if p0:IsDescendantOf(ch) then ourSide, otherSide = p0, p1
                        elseif p1:IsDescendantOf(ch) then ourSide, otherSide = p1, p0 end
                        if ourSide and otherSide then
                            local otherChar = otherSide:FindFirstAncestorOfClass("Model")
                            if otherChar and otherChar ~= ch then
                                local otherPlayer = Players:GetPlayerFromCharacter(otherChar)
                                if otherPlayer and otherPlayer ~= LocalPlayer then
                                    local parentName = ourSide.Name:lower()
                                    if parentName:find("torso")
                                       or parentName:find("rootpart")
                                       or parentName:find("upper") then
                                        -- Locked in place = grabbed
                                        if hrp.AssemblyLinearVelocity.Magnitude < 5 then
                                            escapeFromGrab()
                                            return
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
    end

    local function stopEscapeGrab()
        if escapeGrabConn then escapeGrabConn:Disconnect(); escapeGrabConn = nil end
        if grabHookConn then grabHookConn:Disconnect(); grabHookConn = nil end
    end

    -- ============================================
    -- 🆕 GRAB HELPERS
    -- ============================================
    local function findPlayerByName(name)
        if not name or name == "" then return nil end
        name = name:lower()
        for _, p in Players:GetPlayers() do
            if p ~= LocalPlayer then
                if p.Name:lower() == name or p.DisplayName:lower() == name then return p end
            end
        end
        for _, p in Players:GetPlayers() do
            if p ~= LocalPlayer then
                if p.Name:lower():find(name, 1, true) or p.DisplayName:lower():find(name, 1, true) then return p end
            end
        end
        return nil
    end

    local function teleportAndGrab(targetPlayer)
        if not targetPlayer or not targetPlayer.Character then return end
        local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        local myChar = LocalPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if not targetHRP or not myHRP then return end

        local dist = Settings.GrabDistance or 3
        local newCFrame = targetHRP.CFrame * CFrame.new(0, 0, dist)
        myHRP.CFrame = CFrame.new(newCFrame.Position, targetHRP.Position)
        if myHumanoid then myHumanoid.AutoRotate = false end

        if GrabRF then
            for _ = 1, 8 do
                pcall(function()
                    if GrabRF:IsA("RemoteFunction") then GrabRF:InvokeServer(targetPlayer)
                    else GrabRF:FireServer(targetPlayer) end
                end)
            end
        end

        local startTime = tick()
        while tick() - startTime < 0.25 do
            if targetHRP.Parent and myHRP.Parent then
                myHRP.CFrame = CFrame.new(myHRP.Position, targetHRP.Position)
            end
            RunService.RenderStepped:Wait()
        end
        if myHumanoid then myHumanoid.AutoRotate = true end
    end

    local autoTargetConn = nil
    local function startAutoTarget()
        if autoTargetConn then autoTargetConn:Disconnect() end
        autoTargetConn = RunService.Heartbeat:Connect(function()
            if not Toggles.AutoTarget then return end
            local myChar = LocalPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myHRP then return end
            for _, p in Players:GetPlayers() do
                if p ~= LocalPlayer and p.Character then
                    local theirHRP = p.Character:FindFirstChild("HumanoidRootPart")
                    if theirHRP and (theirHRP.Position - myHRP.Position).Magnitude <= Settings.AutoTargetRange then
                        if GrabRF then
                            pcall(function()
                                if GrabRF:IsA("RemoteFunction") then GrabRF:InvokeServer(p)
                                else GrabRF:FireServer(p) end
                            end)
                        end
                        break
                    end
                end
            end
        end)
    end

    local function stopAutoTarget()
        if autoTargetConn then autoTargetConn:Disconnect(); autoTargetConn = nil end
    end

    local tpGrabConn = nil
    local function startTpGrabLoop()
        if tpGrabConn then tpGrabConn:Disconnect() end
        tpGrabConn = RunService.Heartbeat:Connect(function()
            if not Toggles.TpGrabLoop then return end
            local t1 = findPlayerByName(Settings.GrabTarget1)
            local t2 = findPlayerByName(Settings.GrabTarget2)
            local target = t1 or t2
            if target then teleportAndGrab(target) end
        end)
    end

    local function stopTpGrabLoop()
        if tpGrabConn then tpGrabConn:Disconnect(); tpGrabConn = nil end
    end

    -- ============================================
    -- BANG SYSTEM
    -- ============================================
    local bangConn = nil
    local orbitAngle = 0

    local function getBangTarget()
        local name = Settings.BangTarget
        if name == "" then return nil end
        name = name:lower()
        for _, p in Players:GetPlayers() do
            if p ~= LocalPlayer then
                if p.Name:lower():sub(1, #name) == name or p.DisplayName:lower():sub(1, #name) == name then
                    return p
                end
            end
        end
        return nil
    end

    local function startBang()
        if bangConn then bangConn:Disconnect() end
        orbitAngle = 0
        bangConn = RunService.Heartbeat:Connect(function()
            if not (Toggles.Orbit or Toggles.Headsit or Toggles.Attach or Toggles.MouthBang or Toggles.Bang) then return end
            local target = getBangTarget()
            if not target or not target.Character then return end
            local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
            local targetHead = target.Character:FindFirstChild("Head")
            if not targetHRP then return end
            local myChar = LocalPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myHRP then return end

            if Toggles.Bang then
                local offset = 1.1 + math.sin(tick() * (Settings.BangSpeed * 20)) * 0.8
                myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, offset)
                myHRP.AssemblyLinearVelocity = Vector3.zero
                return
            end
            if Toggles.MouthBang and targetHead then
                local offset = -1.2 - math.sin(tick() * (Settings.BangSpeed * 20)) * 0.8
                myHRP.CFrame = targetHead.CFrame * CFrame.new(0, 0.2, offset) * CFrame.Angles(0, math.pi, 0)
                myHRP.AssemblyLinearVelocity = Vector3.zero
                return
            end
            if Toggles.Attach then
                myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 1.5)
                myHRP.AssemblyLinearVelocity = Vector3.zero
                return
            end
            if Toggles.Headsit and targetHead then
                myHRP.CFrame = targetHead.CFrame * CFrame.new(0, 0.5, 0)
                myHRP.AssemblyLinearVelocity = Vector3.zero
                return
            end
            if Toggles.Orbit then
                orbitAngle = orbitAngle + (0.05 * Settings.BangSpeed)
                local offset = CFrame.Angles(0, orbitAngle, 0) * CFrame.new(0, 0, 5)
                myHRP.CFrame = targetHRP.CFrame * offset
                myHRP.AssemblyLinearVelocity = Vector3.zero
                return
            end
        end)
    end

    local function stopBang()
        if bangConn then bangConn:Disconnect(); bangConn = nil end
    end

    local function isAnyBangActive()
        return Toggles.Orbit or Toggles.Headsit or Toggles.Attach or Toggles.MouthBang or Toggles.Bang
    end

    -- ============================================
    -- KILL AURA (LEGEND edition - nearest target)
    -- ============================================
    local kaConn = nil

    local function isKATarget(name)
        local text = (Settings.KATargets or ""):lower():gsub("^%s*(.-)%s*$", "%1")
        if text == "" or text == "all" then return true end
        local lowerName = name:lower()
        for t in text:gmatch("%S+") do
            if lowerName:find(t, 1, true) then return true end
        end
        return false
    end

    local function doKAHit(hum, pos)
        if not hum or not hum.Parent then return end
        if not HitRF then return end
        pcall(function()
            if HitRF:IsA("RemoteFunction") then
                HitRF:InvokeServer(hum, Vector3.new(pos.X, pos.Y, pos.Z))
            else
                HitRF:FireServer(hum, Vector3.new(pos.X, pos.Y, pos.Z))
            end
        end)
    end

    local function startKA()
        if kaConn then kaConn:Disconnect() end
        kaConn = RunService.Heartbeat:Connect(function()
            if not Toggles.KillAura or not HitRF then return end
            local mc = LocalPlayer.Character
            if not mc then return end
            local myHRP = mc:FindFirstChild("HumanoidRootPart")
            if not myHRP then return end

            local sl = parseList(Settings.KASafe)
            local nearest = nil
            local nearDist = math.huge

            for _, p in Players:GetPlayers() do
                if p == LocalPlayer then continue end
                if not p.Character then continue end
                if isSafe(p.Name, sl) then continue end
                if not isKATarget(p.Name) then continue end

                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChildOfClass("Humanoid")

                if hrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - myHRP.Position).Magnitude
                    if dist <= Settings.KARange and dist < nearDist then
                        nearDist = dist
                        nearest = {
                            hum = hum,
                            pos = hrp.Position + hrp.CFrame.LookVector * 2
                        }
                    end
                end
            end

            if nearest then
                task.spawn(function()
                    doKAHit(nearest.hum, nearest.pos)
                end)
            end
        end)
    end

    local function stopKA()
        if kaConn then kaConn:Disconnect(); kaConn = nil end
    end

    -- ============================================
    -- SPAM GRAB
    -- ============================================
    local grabConn = nil
    local function startGrab()
        if grabConn then grabConn:Disconnect() end
        grabConn = RunService.Heartbeat:Connect(function()
            if not Toggles.SpamGrab or not GrabRF then return end
            local t1 = findPlayerByName(Settings.GrabTarget1)
            local t2 = findPlayerByName(Settings.GrabTarget2)
            if t1 or t2 then
                if t1 then
                    pcall(function()
                        if GrabRF:IsA("RemoteFunction") then GrabRF:InvokeServer(t1)
                        else GrabRF:FireServer(t1) end
                    end)
                end
                if t2 and t2 ~= t1 then
                    pcall(function()
                        if GrabRF:IsA("RemoteFunction") then GrabRF:InvokeServer(t2)
                        else GrabRF:FireServer(t2) end
                    end)
                end
                return
            end
            for _, p in Players:GetPlayers() do
                if p ~= LocalPlayer and p.Character then
                    pcall(function()
                        if GrabRF:IsA("RemoteFunction") then GrabRF:InvokeServer(p)
                        else GrabRF:FireServer(p) end
                    end)
                    break
                end
            end
        end)
    end
    local function stopGrab() if grabConn then grabConn:Disconnect(); grabConn = nil end end

    -- ============================================
    -- HITBOX
    -- ============================================
    local hbConn = nil
    local function startHitbox()
