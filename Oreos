    keyInput.Size = UDim2.new(1, -20, 1, 0)
    keyInput.Position = UDim2.new(0, 10, 0, 0)
    keyInput.BackgroundTransparency = 1
    keyInput.PlaceholderText = CONFIG.PlaceholderText
    keyInput.PlaceholderColor3 = Color3.fromRGB(120, 120, 120)
    keyInput.Text = ""
    keyInput.TextColor3 = Color3.fromRGB(255, 255, 255)
    keyInput.TextXAlignment = Enum.TextXAlignment.Left
    keyInput.Font = Enum.Font.Gotham
    keyInput.TextSize = 14
    keyInput.ClearTextOnFocus = false
    keyInput.Parent = inputFrame

    local submitBtn = Instance.new("TextButton")
    submitBtn.Size = UDim2.new(1, -40, 0, 40)
    submitBtn.Position = UDim2.new(0, 20, 0, 148)
    submitBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    submitBtn.Text = "SUBMIT"
    submitBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
    submitBtn.Font = Enum.Font.GothamBold
    submitBtn.TextSize = 14
    submitBtn.BorderSizePixel = 0
    submitBtn.Parent = frame
    Instance.new("UICorner", submitBtn).CornerRadius = UDim.new(0, 8)

    local keyStatus = Instance.new("TextLabel")
    keyStatus.Size = UDim2.new(1, -40, 0, 18)
    keyStatus.Position = UDim2.new(0, 20, 0, 196)
    keyStatus.BackgroundTransparency = 1
    keyStatus.Text = ""
    keyStatus.TextColor3 = Color3.fromRGB(255, 50, 50)
    keyStatus.TextXAlignment = Enum.TextXAlignment.Left
    keyStatus.Font = Enum.Font.Gotham
    keyStatus.TextSize = 11
    keyStatus.Parent = frame

    local function trySubmit()
        local entered = keyInput.Text
        if entered == "" then
            keyStatus.Text = "⚠️ Please enter a key!"
            keyStatus.TextColor3 = Color3.fromRGB(255, 200, 0)
            return
        end
        if validateKey(entered) then
            keyStatus.Text = "✅ Key accepted!"
            keyStatus.TextColor3 = Color3.fromRGB(50, 255, 100)
            PlayOreoCrunch()
            sendWebhookLog("✅ Key Accepted", "Player entered the **correct key** and unlocked Oreo's Hub!", 5763719)
            task.wait(0.5)
            blur:Destroy()
            gui:Destroy()
            loadOreosHub()
        else
            keyStatus.Text = "❌ Invalid key!"
            keyStatus.TextColor3 = Color3.fromRGB(255, 50, 50)
            keyInput.Text = ""
            sendWebhookLog("❌ Wrong Key", "Player tried wrong key: `" .. entered .. "`", 15548997)
        end
    end

    submitBtn.MouseButton1Click:Connect(trySubmit)
    keyInput.FocusLost:Connect(function(enter)
        if enter then trySubmit() end
    end)

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -40, 0, 10)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 18
    closeBtn.Parent = frame
    closeBtn.MouseButton1Click:Connect(function()
        blur:Destroy()
        gui:Destroy()
    end)

    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    frame.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
end

