    print("   Bio Text:     ", bioRemote and bioRemote.Name or "❌ Not found")
    print("   Bio Color:    ", bioColorRemote and bioColorRemote.Name or "❌ Not found")
    print("   Name Text:    ", nameRemote and nameRemote.Name or "❌ Not found")
    print("   Name Color:   ", nameColorRemote and nameColorRemote.Name or "❌ Not found")
    print("=============================")

    local function parseList(str)
        local t = {}
        if str == "" then return t end
        for w in str:gmatch("%S+") do table.insert(t, w:lower()) end
        return t
    end
    local function isTarget(n, list)
        if #list == 0 then return true end
        for _, v in ipairs(list) do if n:lower():find(v, 1, true) then return true end end
        return false
    end
    local function isSafe(n, list)
        for _, v in ipairs(list) do if n:lower():find(v, 1, true) then return true end end
        return false
    end

