    local function startGlowBio()
        if bioConn then bioConn:Disconnect() end
        applyBioText(Settings.BioText)
        if Toggles.NameGlow and nameRemote and not rpNameSetOnce then
            rpNameSetOnce = true
            pcall(function()
                if nameRemote:IsA("RemoteFunction") then nameRemote:InvokeServer(Settings.RPNameText) else nameRemote:FireServer(Settings.RPNameText) end
            end)
        end

        local hue, toggleState, lastToggleSwitch = 0, false, 0

        bioConn = RunService.Heartbeat:Connect(function(dt)
            if not Toggles.GlowBio then return end
            local now = tick()
            local speed = Settings.BioSpeed
            local intensity = Settings.BioGlowIntensity or 0.5
            local mode = Settings.BioColorMode

            -- 🌟 GLOBAL PULSE ENGINE: Makes EVERY mode breathe and glow dynamically
            local pulse = (math.sin(now * speed * 3) + 1) / 2
            local function applyPulsedColor(baseColor)
                local h, s, v = Color3.toHSV(baseColor)
                local glowingV = math.clamp(v + (pulse * intensity), 0, 1)
                applyColors(Color3.fromHSV(h, s, glowingV))
            end

            local function alternate(colorA, colorB)
                local switchInterval = 1 / math.max(speed, 0.1)
                if now - lastToggleSwitch >= switchInterval then
                    toggleState = not toggleState
                    lastToggleSwitch = now
                end
                if toggleState then applyPulsedColor(colorA) else applyPulsedColor(colorB) end
            end

            -- 🌟 ULTRA-GLOW MODES
            if mode == "neon_pulse" then alternate(Color3.fromRGB(0, 255, 255), Color3.fromRGB(255, 0, 255))
            elseif mode == "electric_spark" then
                if math.random() < 0.15 * speed then applyPulsedColor(Color3.fromRGB(255, 255, 255)) else applyPulsedColor(Color3.fromRGB(0, 150, 255)) end
            elseif mode == "toxic_glow" then alternate(Color3.fromRGB(57, 255, 20), Color3.fromRGB(0, 50, 0))
            elseif mode == "inferno" then alternate(Color3.fromRGB(255, 50, 0), Color3.fromRGB(255, 200, 0))
            elseif mode == "cyber_wave" then
                hue = (hue + (speed * 0.2 * dt)) % 1
                alternate(Color3.fromHSV(hue, 1, 1), Color3.fromHSV((hue + 0.5) % 1, 1, 1))
            elseif mode == "ghost" then
                local v = pulse
                applyColors(Color3.fromRGB(v*255, v*255, v*255))
            
            -- 🌟 CLASSIC MODES (Now with Global Pulse Engine)
            elseif mode == "black_white" then alternate(Color3.fromRGB(0, 0, 0), Color3.fromRGB(255, 255, 255))
            elseif mode == "rainbow" then hue = (hue + (speed * 0.3 * dt)) % 1; applyPulsedColor(Color3.fromHSV(hue, 1, 1))
            elseif mode == "police" then alternate(Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 0, 255))
            elseif mode == "purple_blue" then alternate(Color3.fromRGB(160, 32, 240), Color3.fromRGB(0, 100, 255))
            elseif mode == "red_black" then alternate(Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 0, 0))
            elseif mode == "pink_cyan" then alternate(Color3.fromRGB(255, 105, 180), Color3.fromRGB(0, 255, 255))
            elseif mode == "gold_silver" then alternate(Color3.fromRGB(255, 215, 0), Color3.fromRGB(192, 192, 192))
            elseif mode == "neon_green" then alternate(Color3.fromRGB(0, 255, 0), Color3.fromRGB(0, 100, 0))
            elseif mode == "matrix" then alternate(Color3.fromRGB(0, 255, 0), Color3.fromRGB(0, 0, 0))
            elseif mode == "blood" then alternate(Color3.fromRGB(139, 0, 0), Color3.fromRGB(255, 0, 0))
            elseif mode == "cyberpunk" then alternate(Color3.fromRGB(255, 0, 255), Color3.fromRGB(0, 255, 255))
            elseif mode == "halloween" then alternate(Color3.fromRGB(255, 100, 0), Color3.fromRGB(80, 0, 120))
            elseif mode == "custom" then applyPulsedColor(Settings.BioCustomColor)
            else applyPulsedColor(Color3.fromRGB(255, 255, 255)) -- Fallback
            end
        end)
    end

