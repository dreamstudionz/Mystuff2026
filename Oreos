    local function startGlowBio()
        if bioConn then bioConn:Disconnect() end
        applyBioText(Settings.BioText)
        if Toggles.NameGlow then applyRPNameTextOnce(Settings.RPNameText) end

        local hue = 0
        local toggleState = false
        local lastToggleSwitch = 0

        bioConn = RunService.Heartbeat:Connect(function(dt)
            if not Toggles.GlowBio then return end

            local now = tick()
            local switchInterval = 1 / Settings.BioSpeed
            local mode = Settings.BioColorMode

            local function alternate(colorA, colorB)
                if now - lastToggleSwitch >= switchInterval then
                    toggleState = not toggleState
                    lastToggleSwitch = now
                end
                if toggleState then applyColors(colorA)
                else applyColors(colorB) end
            end

            if mode == "black_white" then
                local phase = math.floor(tick() * Settings.BioSpeed) % 2
                if phase == 0 then applyColors(Color3.fromRGB(0, 0, 0))
                else applyColors(Color3.fromRGB(255, 255, 255)) end
            elseif mode == "rainbow" then
                hue = (hue + (Settings.BioSpeed * 0.5 * dt)) % 1
                applyColors(Color3.fromHSV(hue, 1, 1))
            elseif mode == "police" then
                alternate(Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 0, 255))
            elseif mode == "orange_black" then
                alternate(Color3.fromRGB(255, 140, 0), Color3.fromRGB(0, 0, 0))
            elseif mode == "purple_blue" then
                alternate(Color3.fromRGB(160, 32, 240), Color3.fromRGB(0, 100, 255))
            elseif mode == "yellow_green" then
                alternate(Color3.fromRGB(255, 240, 0), Color3.fromRGB(0, 255, 50))
            elseif mode == "red_black" then
                alternate(Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 0, 0))
            elseif mode == "pink_cyan" then
                alternate(Color3.fromRGB(255, 105, 180), Color3.fromRGB(0, 255, 255))
            elseif mode == "gold_silver" then
                alternate(Color3.fromRGB(255, 215, 0), Color3.fromRGB(192, 192, 192))
            elseif mode == "neon_green" then
                alternate(Color3.fromRGB(0, 255, 0), Color3.fromRGB(0, 100, 0))
            elseif mode == "lava" then
                alternate(Color3.fromRGB(255, 60, 0), Color3.fromRGB(255, 200, 0))
            elseif mode == "ice" then
                alternate(Color3.fromRGB(150, 220, 255), Color3.fromRGB(255, 255, 255))
            elseif mode == "custom" then
                applyColors(Settings.BioCustomColor)
            end
        end)
    end

