    local function applyColors(color)
        if lastBioColor == color then return end
        lastBioColor = color
        pcall(function()
            if bioColorRemote then
                if bioColorRemote:IsA("RemoteFunction") then bioColorRemote:InvokeServer(color) else bioColorRemote:FireServer(color) end
            end
            if Toggles.NameGlow and nameColorRemote then
                if lastRPColor ~= color then
                    lastRPColor = color
                    if nameColorRemote:IsA("RemoteFunction") then nameColorRemote:InvokeServer(color) else nameColorRemote:FireServer(color) end
                end
