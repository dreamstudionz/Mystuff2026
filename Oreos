            Rayfield:Notify({
                Title = "☁️ SkySafe",
                Content = "You need a character first",
                Duration = 3,
                Image = 4483362458
            })
            return
        end

        skyOriginalPos = hrp.CFrame

        if skyPlatform then skyPlatform:Destroy() end
        skyPlatform = createSkyPlatform()
        skyPlatform.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y + SKY_HEIGHT, hrp.Position.Z)
        hrp.CFrame = CFrame.new(skyPlatform.Position + Vector3.new(0, 5, 0))

        if skyHeartbeatConn then skyHeartbeatConn:Disconnect() end
        skyHeartbeatConn = RunService.Heartbeat:Connect(function()
            if not skySafeEnabled then return end
            local ch = LocalPlayer.Character
            local r = ch and ch:FindFirstChild("HumanoidRootPart")
            if not r or not skyPlatform then return end
            if r.Position.Y < skyPlatform.Position.Y - 10 then
                r.CFrame = CFrame.new(skyPlatform.Position + Vector3.new(0, 5, 0))
                r.AssemblyLinearVelocity = Vector3.zero
            end
        end)

        Rayfield:Notify({
            Title = "☁️ SkySafe",
            Content = "You're safe in the sky!",
            Duration = 4,
            Image = 4483362458
        })
        sendWebhookLog("☁️ SkySafe", "Enabled SkySafe Zone", 5763719)
    end

    local function disableSkySafe()
        if skyHeartbeatConn then
            skyHeartbeatConn:Disconnect()
            skyHeartbeatConn = nil
        end
        if skyPlatform then
            skyPlatform:Destroy()
            skyPlatform = nil
        end
        local ch = LocalPlayer.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if hrp and skyOriginalPos then
            pcall(function()
                hrp.CFrame = skyOriginalPos
                hrp.AssemblyLinearVelocity = Vector3.zero
            end)
        end
        skyOriginalPos = nil
        Rayfield:Notify({
            Title = "☁️ SkySafe",
            Content = "SkySafe disabled — returned to ground",
            Duration = 3,
            Image = 4483362458
        })
        sendWebhookLog("☁️ SkySafe", "Disabled SkySafe Zone", 15548997)
    end

    SettingsTab:CreateToggle({
        Name = "☁️ SkySafe Zone (Safe in the sky)",
        CurrentValue = false,
        Flag = "SkySafeToggle",
        Callback = function(v)
            PlayClickSound()
            skySafeEnabled = v
            if v then enableSkySafe() else disableSkySafe() end
        end
    })

    SettingsTab:CreateLabel("⬆️ Teleports you high in the sky on an invisible platform")
    SettingsTab:CreateLabel("🏃 You can walk & run freely on it")
    SettingsTab:CreateLabel("🔒 Nobody else can see or reach the platform")
    SettingsTab:CreateLabel("⚠️ Strict anti-cheat games may still detect you")

    SettingsTab:CreateSlider({
        Name = "Sky Height",
        Range = {100, 2000},
        Increment = 50,
        Suffix = "studs",
        CurrentValue = 500,
        Flag = "SkyHeight",
        Callback = function(v)
            SKY_HEIGHT = v
            if skySafeEnabled and skyPlatform then
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    skyPlatform.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y + SKY_HEIGHT, hrp.Position.Z)
                    hrp.CFrame = CFrame.new(skyPlatform.Position + Vector3.new(0, 5, 0))
                end
            end
        end
    })

    SettingsTab:CreateDivider()
    SettingsTab:CreateSection("About")
    SettingsTab:CreateLabel("🍪 Oreo's Hub")
    SettingsTab:CreateLabel("Made by Oreo")
    SettingsTab:CreateLabel("Discord: @oreo.fv")

    Rayfield:Notify({
        Title = "🍪 Oreo's Hub",
        Content = "Hub loaded successfully!",
        Duration = 5,
        Image = 4483362458
    })

    print("🍪 Oreo's Hub LOADED")
end

