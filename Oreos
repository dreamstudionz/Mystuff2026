    local bangConn, orbitAngle = nil, 0
    local function getBangTarget()
        local name = Settings.BangTarget
        if name == "" then return nil end
        name = name:lower()
        for _, p in Players:GetPlayers() do if p ~= LocalPlayer and (p.Name:lower():sub(1, #name) == name or p.DisplayName:lower():sub(1, #name) == name) then return p end end
        return nil
    end
    local function startBang()
        if bangConn then bangConn:Disconnect() end
        orbitAngle = 0
        bangConn = RunService.Heartbeat:Connect(function()
            if not (Toggles.Orbit or Toggles.Headsit or Toggles.Attach or Toggles.MouthBang or Toggles.Bang or Toggles.PulseOrbit or Toggles.VerticalOrbit) then return end
            local target = getBangTarget()
            if not target or not target.Character then return end
            local targetHRP, targetHead, myHRP = target.Character:FindFirstChild("HumanoidRootPart"), target.Character:FindFirstChild("Head"), LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not targetHRP or not myHRP then return end

            if Toggles.Bang then myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 1.1 + math.sin(tick() * (Settings.BangSpeed * 20)) * 0.8); myHRP.AssemblyLinearVelocity = Vector3.zero; return end
            if Toggles.MouthBang and targetHead then myHRP.CFrame = targetHead.CFrame * CFrame.new(0, 0.2, -1.2 - math.sin(tick() * (Settings.BangSpeed * 20)) * 0.8) * CFrame.Angles(0, math.pi, 0); myHRP.AssemblyLinearVelocity = Vector3.zero; return end
            if Toggles.Attach then myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 1.5); myHRP.AssemblyLinearVelocity = Vector3.zero; return end
            if Toggles.Headsit and targetHead then myHRP.CFrame = targetHead.CFrame * CFrame.new(0, 0.5, 0); myHRP.AssemblyLinearVelocity = Vector3.zero; return end
            if Toggles.Orbit then orbitAngle = orbitAngle + (0.05 * Settings.BangSpeed); myHRP.CFrame = targetHRP.CFrame * CFrame.Angles(0, orbitAngle, 0) * CFrame.new(0, 0, 5); myHRP.AssemblyLinearVelocity = Vector3.zero; return end
            if Toggles.PulseOrbit then
                orbitAngle = orbitAngle + (0.03 * Settings.BangSpeed)
                local midR, ampR = (Settings.PulseOrbitMaxRadius + Settings.PulseOrbitMinRadius) / 2, (Settings.PulseOrbitMaxRadius - Settings.PulseOrbitMinRadius) / 2
                local currentRadius = midR + math.sin(tick() * Settings.PulseOrbitSpeed * 2 * math.pi) * ampR
                myHRP.CFrame = targetHRP.CFrame * CFrame.Angles(0, orbitAngle, 0) * CFrame.new(0, 0, currentRadius); myHRP.AssemblyLinearVelocity = Vector3.zero; return
            end
            if Toggles.VerticalOrbit then
                orbitAngle = orbitAngle + (0.02 * Settings.BangSpeed)
                local midY, ampY = (Settings.VerticalOrbitTopOffset + Settings.VerticalOrbitBottomOffset) / 2, (Settings.VerticalOrbitTopOffset - Settings.VerticalOrbitBottomOffset) / 2
                local currentY = midY + math.sin(tick() * Settings.VerticalOrbitSpeed * math.pi) * ampY
                myHRP.CFrame = targetHRP.CFrame * CFrame.Angles(0, orbitAngle, 0) * CFrame.new(0, currentY, 3); myHRP.AssemblyLinearVelocity = Vector3.zero; return
            end
        end)
    end
    local function stopBang() if bangConn then bangConn:Disconnect(); bangConn = nil end end
    local function isAnyBangActive() return Toggles.Orbit or Toggles.Headsit or Toggles.Attach or Toggles.MouthBang or Toggles.Bang or Toggles.PulseOrbit or Toggles.VerticalOrbit end

    local kaConn = nil
    local function isKATarget(name)
        local text = (Settings.KATargets or ""):lower():gsub("^%s*(.-)%s*$", "%1")
        if text == "" or text == "all" then return true end
        for t in text:gmatch("%S+") do if name:lower():find(t, 1, true) then return true end end
        return false
    end
    local function doKAHit(hum, pos)
        if not hum or not hum.Parent or not HitRF then return end
        pcall(function()
            if HitRF:IsA("RemoteFunction") then HitRF:InvokeServer(hum, Vector3.new(pos.X, pos.Y, pos.Z)) else HitRF:FireServer(hum, Vector3.new(pos.X, pos.Y, pos.Z)) end
        end)
    end
    local function startKA()
        if kaConn then kaConn:Disconnect() end
        kaConn = RunService.Heartbeat:Connect(function()
            if not Toggles.KillAura or not HitRF then return end
            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not myHRP then return end
            local sl = {}
            for w in (Settings.KASafe or ""):gsub("%S+", function(s) table.insert(sl, s:lower()) end) do end
            local nearest, nearDist = nil, math.huge
            for _, p in Players:GetPlayers() do
                if p == LocalPlayer or not p.Character then continue end
                local name = p.Name:lower()
                local skip = false
                for _, safe in ipairs(sl) do if name:find(safe, 1, true) then skip = true; break end end
                if skip or not isKATarget(p.Name) then continue end
                local hrp, hum = p.Character:FindFirstChild("HumanoidRootPart"), p.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local healthPercent = hum.Health / hum.MaxHealth * 100
                    if Settings.KAHealthStop > 0 and healthPercent <= Settings.KAHealthStop then continue end
                    local dist = (hrp.Position - myHRP.Position).Magnitude
                    if dist <= Settings.KARange and dist < nearDist then
                        nearDist = dist
                        nearest = { hum = hum, pos = hrp.Position + hrp.CFrame.LookVector * 2 }
                    end
                end
            end
            if nearest then task.spawn(function() doKAHit(nearest.hum, nearest.pos) end) end
        end)
    end
    local function stopKA() if kaConn then kaConn:Disconnect(); kaConn = nil end end

