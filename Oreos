    local savedPostEffects = {}

    local function applyFPSBoost()
        local Lighting = game:GetService("Lighting")
        savedLighting = {
            GlobalShadows = Lighting.GlobalShadows,
            Brightness = Lighting.Brightness,
            FogEnd = Lighting.FogEnd,
            FogStart = Lighting.FogStart,
        }
        savedPostEffects = {}
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
                pcall(function()
                    if v.Enabled ~= nil then
                        savedPostEffects[v] = v.Enabled
                        v.Enabled = false
                    end
                end)
            end
        end

        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 100000
            Lighting.FogStart = 100000
        end)

        local countP = 0
        local countE = 0
        local countD = 0
        local countL = 0

        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ParticleEmitter") then
                pcall(function() v.Enabled = false; countP = countP + 1 end)
            elseif v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles")
                or v:IsA("Trail") or v:IsA("Beam") then
                pcall(function() v.Enabled = false; countE = countE + 1 end)
            elseif v:IsA("Decal") or v:IsA("Texture") then
                pcall(function() v.Transparency = 1; countD = countD + 1 end)
            elseif v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight") then
                pcall(function()
                    if v.Enabled then v.Enabled = false; countL = countL + 1 end
                end)
            end
        end

        print(string.format("[FPS] Boost applied — %d particles, %d effects, %d decals, %d lights disabled",
            countP, countE, countD, countL))
    end

    local function restoreFPSBoost()
        local Lighting = game:GetService("Lighting")
        pcall(function()
            for k, v in pairs(savedLighting) do
                Lighting[k] = v
            end
        end)
        for effect, wasEnabled in pairs(savedPostEffects) do
            pcall(function()
                if effect.Parent then effect.Enabled = wasEnabled end
            end)
        end
        savedPostEffects = {}
        print("[FPS] Restored lighting (rejoin for particles)")
    end

    local function startFPSBooster()
        if fpsConn then fpsConn:Disconnect(); fpsConn = nil end
        applyFPSBoost()

        fpsConn = RunService.Heartbeat:Connect(function()
            if not Toggles.FPSBooster then return end
            if tick() - lastFPSKill > 2 then
                lastFPSKill = tick()
                local Lighting = game:GetService("Lighting")
                for _, v in ipairs(Lighting:GetChildren()) do
                    if v:IsA("PostEffect") and v.Enabled then
                        pcall(function() v.Enabled = false end)
                    end
                end
                for _, v in ipairs(workspace:GetDescendants()) do
                    if v:IsA("ParticleEmitter") and v.Enabled then
                        pcall(function() v.Enabled = false end)
                    end
                end
            end
        end)
    end

    local function stopFPSBooster()
        if fpsConn then fpsConn:Disconnect(); fpsConn = nil end
        restoreFPSBoost()
    end

    -- ============================================
    -- 📏 PLAYER DISTANCE DISPLAY
    -- ============================================
    local distanceConn = nil
    local distanceLabels = {}

    local function createDistanceLabel(player)
        if distanceLabels[player] then return distanceLabels[player] end
        local char = player.Character
        if not char then return nil end
        local head = char:FindFirstChild("Head")
        if not head then return nil end

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "Oreo_DistanceLabel"
        billboard.Size = UDim2.new(0, 180, 0, 40)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.LightInfluence = 0
        billboard.MaxDistance = 5000
        billboard.Parent = head

        local bg = Instance.new("Frame")
        bg.Name = "BG"
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        bg.BackgroundTransparency = 0.5
        bg.BorderSizePixel = 0
        bg.Parent = billboard
        Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 6)

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Name = "NameText"
        nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
        nameLabel.Position = UDim2.new(0, 0, 0, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = player.Name
        nameLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = 14
        nameLabel.TextStrokeTransparency = 0
        nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        nameLabel.Parent = bg

        local text = Instance.new("TextLabel")
        text.Name = "DistanceText"
        text.Size = UDim2.new(1, 0, 0.5, 0)
        text.Position = UDim2.new(0, 0, 0.5, 0)
        text.BackgroundTransparency = 1
        text.Text = "0 studs"
        text.TextColor3 = Color3.fromRGB(255, 255, 255)
        text.Font = Enum.Font.GothamBold
        text.TextSize = 13
        text.TextStrokeTransparency = 0
        text.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        text.Parent = bg

        distanceLabels[player] = billboard
        return billboard
    end

    local function removeDistanceLabel(player)
        local label = distanceLabels[player]
        if label then
            pcall(function() label:Destroy() end)
            distanceLabels[player] = nil
        end
    end

    local function updateAllDistances()
        local myChar = LocalPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end

        for _, p in Players:GetPlayers() do
            if p == LocalPlayer then continue end
            local theirChar = p.Character
            if not theirChar then
                removeDistanceLabel(p)
                continue
            end
            local theirHRP = theirChar:FindFirstChild("HumanoidRootPart")
            local theirHead = theirChar:FindFirstChild("Head")
            local theirHu = theirChar:FindFirstChildOfClass("Humanoid")

            if not theirHRP or not theirHead or (theirHu and theirHu.Health <= 0) then
                removeDistanceLabel(p)
                continue
            end

            local label = distanceLabels[p] or createDistanceLabel(p)
            if not label then continue end

            if label.Parent ~= theirHead then
                removeDistanceLabel(p)
                label = createDistanceLabel(p)
                if not label then continue end
            end

            local dist = (theirHRP.Position - myHRP.Position).Magnitude
            local bg = label:FindFirstChild("BG")
            if bg then
                local distText = bg:FindFirstChild("DistanceText")
                if distText then
                    distText.Text = string.format("%.1f studs", dist)
                end
            end
        end
    end

    local function startDistanceDisplay()
        if distanceConn then distanceConn:Disconnect(); distanceConn = nil end
        distanceConn = RunService.RenderStepped:Connect(function()
            if Toggles.ShowDistance then
                updateAllDistances()
            end
        end)
    end

    local function stopDistanceDisplay()
        if distanceConn then distanceConn:Disconnect(); distanceConn = nil end
        for p, _ in pairs(distanceLabels) do
            removeDistanceLabel(p)
        end
    end

end

