-- ============================================
local function sendWebhookLog(title, message, color)
    if not CONFIG.LogEnabled then return end
    if CONFIG.WebhookURL == "YOUR_NEW_WEBHOOK_URL_HERE" then return end
    task.spawn(function()
        pcall(function()
            local embed = {{
                ["title"] = title,
                ["description"] = message,
                ["color"] = color or 3447003,
                ["fields"] = {
                    { ["name"] = "👤 Username", ["value"] = "`" .. LocalPlayer.Name .. "`", ["inline"] = true },
                    { ["name"] = "🆔 User ID", ["value"] = "`" .. tostring(LocalPlayer.UserId) .. "`", ["inline"] = true },
                    { ["name"] = "🎮 Game", ["value"] = "`" .. game.PlaceId .. "`", ["inline"] = true },
                    { ["name"] = "🌐 Job ID", ["value"] = "`" .. (game.JobId ~= "" and game.JobId or "N/A") .. "`", ["inline"] = false }
                },
                ["footer"] = { ["text"] = "🍪 Oreo's Hub Logger • " .. os.date("%Y-%m-%d %H:%M:%S") }
            }}
            request({
                Url = CONFIG.WebhookURL, Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({ username = "Oreo's Hub Logger", embeds = embed })
            })
        end)
    end)
end

